program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 8, 375, 128]> q_v, tensor<fp16, [1, 8, 375, 128]> k_headsT, tensor<fp16, [1, 8, 128, 749]> pos_kT) {
    fp16 const_7_to_fp16 = const()[name = string("op_7_to_fp16"), val = fp16(0x1.0p-3)];
    tensor<fp16, [1, 8, 375, 749]> attention_scores_1 = matmul(transpose_x = bool(false), transpose_y = bool(false), x = q_v, y = pos_kT)[name = string("attention_scores_1")];
    tensor<fp16, [1, 8, 375, 128]> mul_0_cast_fp16 = mul(x = q_v, y = const_7_to_fp16)[name = string("mul_0_cast_fp16")];
    bool matmul_0_transpose_y_0 = const()[name = string("matmul_0_transpose_y_0"), val = bool(true)];
    bool matmul_0_transpose_x_0 = const()[name = string("matmul_0_transpose_x_0"), val = bool(false)];
    tensor<fp16, [1, 8, 375, 375]> matmul_0 = matmul(transpose_x = matmul_0_transpose_x_0, transpose_y = matmul_0_transpose_y_0, x = mul_0_cast_fp16, y = k_headsT)[name = string("matmul_0")];
    } -> (attention_scores_1, matmul_0);
}
