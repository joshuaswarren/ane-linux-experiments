From 60c4903f4b9533658a518b710f90c0560770a104 Mon Sep 17 00:00:00 2001
From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Date: Tue, 22 Sep 2026 07:41:03 -0500
Subject: [PATCH] gdn prefill: workgroup-parallel shared loads, double-buffered
 k/q/g slots, skip o-dot in the prefix pass

Pass-0 prefix scan was 59.3ms/layer at gx=16 (52% of prefill wall):
row 0 alone staged k/q/g through shared memory and every token paid two
barriers; the scan also computed the ns*q output dot it never reads.
Now thread i stages element i, one barrier per token (double-buffered
slots make slot reuse safe), and o_acc is only accumulated in the
output pass. State arithmetic and all output values are unchanged, so
the token digest is preserved by construction.
---
 .../omarchy/shaders/gated_delta_prefill.comp  | 65 ++++++++++---------
 1 file changed, 34 insertions(+), 31 deletions(-)

diff --git a/overlay/mlx/backend/omarchy/shaders/gated_delta_prefill.comp b/overlay/mlx/backend/omarchy/shaders/gated_delta_prefill.comp
index b7c93249..6778cf04 100644
--- a/overlay/mlx/backend/omarchy/shaders/gated_delta_prefill.comp
+++ b/overlay/mlx/backend/omarchy/shaders/gated_delta_prefill.comp
@@ -86,9 +86,10 @@ uint16_t bf16_store(float value) {
   return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
 }
 
-shared float sk[128];
-shared float sq[128];
-shared float sg[128];
+shared float sk[2][128];
+shared float sq[2][128];
+shared float sg[2][128];
+
 
 float load_g_scalar(uint t, uint head, uint hv) {
   if ((params.flags & 4u) != 0u) {
@@ -97,20 +98,11 @@ float load_g_scalar(uint t, uint head, uint hv) {
   return bf16_load(g_buf.v[params.shape[0] + t * hv + head]);
 }
 
-void load_g_vec(uint t, uint head, uint hv, uint dk) {
-  if (gl_LocalInvocationID.x != 0u) {
-    return;
-  }
-  for (uint i = 0u; i < dk; ++i) {
-    sg[i] = (params.flags & 4u) != 0u
-        ? g_buf_f.v[params.shape[0] + (t * hv + head) * dk + i]
-        : bf16_load(g_buf.v[params.shape[0] + (t * hv + head) * dk + i]);
-  }
-}
+// g vector load is done inline in main(), spread across the workgroup.
 
 // One token's recurrence on the register-resident state row |st|. Each
 // thread owns a full Dv row, so delta never crosses threads; k/q/g ride
-// shared because row 0 loads them once for all 128 rows. Arithmetic
+// shared because the workgroup stages k/q/g together each token. Arithmetic
 // mirrors the ops path elementwise rounding.
 void token_step(
     inout float st[128],
@@ -119,6 +111,8 @@ void token_step(
     float beta,
     float g,
     float v_row,
+    bool compute_o,
+    uint buf,
     out float o_acc) {
   o_acc = 0.0f;
   if (!tok) {
@@ -129,22 +123,26 @@ void token_step(
   // keeps the driver from fusing these into FMAs.
   precise float kv_acc = 0.0f;
   for (uint i = 0u; i < dk; ++i) {
-    precise float gi = (params.flags & 1u) != 0u ? sg[i] : g;
+    precise float gi = (params.flags & 1u) != 0u ? sg[buf][i] : g;
     precise float p = st[i] * gi;
-    p = p * sk[i];
+    p = p * sk[buf][i];
     kv_acc += p;
   }
   precise float delta = (v_row - kv_acc) * beta;
   for (uint i = 0u; i < dk; ++i) {
-    precise float gi = (params.flags & 1u) != 0u ? sg[i] : g;
+    precise float gi = (params.flags & 1u) != 0u ? sg[buf][i] : g;
     precise float dec = st[i] * gi;
     // The ops reference stores the decayed state, then its eager-fused
     // add(state, k*delta) elementwise kernel contracts the multiply-add;
     // mirror that with an explicit fma.
-    precise float ns = fma(delta, sk[i], dec);
+    precise float ns = fma(delta, sk[buf][i], dec);
     st[i] = ns;
-    precise float o = ns * sq[i];
-    o_acc += o;
+    if (compute_o) {
+      // Output pass only: the prefix scan never reads o_acc, so the
+      // ns*q dot is skipped there (state arithmetic is untouched).
+      precise float o = ns * sq[buf][i];
+      o_acc += o;
+    }
   }
 }
 
@@ -193,13 +191,19 @@ void main() {
     if ((params.flags & 2u) != 0u) {
       tok = m_buf.v[params.shape[3] + t] != 0u;
     }
-    if (row == 0u) {
-      for (uint i = 0u; i < dk; ++i) {
-        sk[i] = bf16_load(k_buf.v[params.rhs_offset + t_head * dk + i]);
-        sq[i] = bf16_load(q_buf.v[params.lhs_offset + t_head * dk + i]);
-      }
+    // Parallel shared load: thread i stages k/q (and per-Dk g when
+    // present) into this token's double-buffer slot, then one barrier
+    // orders the load before every thread's token_step. The second slot
+    // lets the next iteration's writes (two steps later) safely wait on
+    // the single per-iteration barrier.
+    uint buf = t & 1u;
+    if (row < dk) {
+      sk[buf][row] = bf16_load(k_buf.v[params.rhs_offset + t_head * dk + row]);
+      sq[buf][row] = bf16_load(q_buf.v[params.lhs_offset + t_head * dk + row]);
       if ((params.flags & 1u) != 0u) {
-        load_g_vec(t, head, hv, dk);
+        sg[buf][row] = (params.flags & 4u) != 0u
+            ? g_buf_f.v[params.shape[0] + (t * hv + head) * dk + row]
+            : bf16_load(g_buf.v[params.shape[0] + (t * hv + head) * dk + row]);
       }
     }
     barrier();
@@ -209,8 +213,7 @@ void main() {
     float v_row = bf16_load(v_buf.v[params.aux_size + t_head * dv + row]);
 
     float o_acc;
-    token_step(st, dk, tok, beta, g, v_row, o_acc);
-    barrier();
+    token_step(st, dk, tok, beta, g, v_row, out_pass, buf, o_acc);
 
     if (out_pass) {
       y_buf.v[params.output_offset + t_head * dv + row] =
@@ -223,9 +226,9 @@ void main() {
         snap.v[snap_base + i] = st[i];
       }
     }
-    // Order this iteration's shared-memory reads before row 0 overwrites
-    // sk/sq/sg for the next token.
-    barrier();
+    // No trailing barrier: the next iteration reads the other shared
+    // slot, and its load barrier orders the slot reuse after every
+    // thread's reads from two slots ago.
   }
 
   if (out_pass && chunk + 1u == params.chunks) {
-- 
2.55.0

