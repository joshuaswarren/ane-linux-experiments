+/* Best effort: keep the iBoot-preloaded ANE firmware out of the Linux RAM map. Never fails. */
+static void dt_reserve_ane_firmware(void)
+{
+    int node = adt_path_offset(adt, "/arm-io/ane0");
+    if (node < 0)
+        node = adt_path_offset(adt, "/arm-io/ane");
+    if (node < 0) {
+        printf("ANE: no ADT node, nothing reserved\n");
+        return;
+    }
+
+    u32 len = 0;
+    const struct adt_segment_ranges *seg = adt_getprop(adt, node, "segment-ranges", &len);
+    if (!seg || len < sizeof(*seg)) {
+        printf("ANE: no segment-ranges, nothing reserved\n");
+        return;
+    }
+
+    for (unsigned int i = 0; i < len / sizeof(*seg); i++, seg++) {
+        char name[64];
+        snprintf(name, sizeof(name), "ane-firmware@%lx", seg->phys);
+        size_t size = ALIGN_UP(seg->size, SZ_16K);
+        if (dt_get_or_add_reserved_mem(name, "apple,asc-mem", true, seg->phys, size) < 0) {
+            printf("ANE: reserving %s failed, stopping\n", name);
+            return;
+        }
+        printf("ANE: reserved %s size 0x%zx remap 0x%lx\n", name, size, seg->remap);
+    }
+}
