+/* SPDX-License-Identifier: MIT */
+
+#ifndef ANE_BRINGUP_H
+#define ANE_BRINGUP_H
+
+#include <stdbool.h>
+#include <stddef.h>
+
+/* Boot-time T6021 ANE bring-up. Runs from run_actions() before the payload
+ * chainload; a text log of everything it observed/did is later attached to
+ * the FDT passed to Linux as /chosen/ane-bringup-log.
+ *
+ * ANE_BRINGUP_WRITE (build-cfg): 0 = dry mode, reads and ADT dumps only.
+ *                               1 = full arm (power cycle, RVBAR, RUN).
+ */
+void ane_bringup_run(void);
+const char *ane_bringup_log(size_t *len);
+
+#endif
