// High-pressure atomicOr variant: n = 4M invocations, disjoint-half OR pairs.
#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 1, std430) buffer Output { uint values[]; };
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= 4194304u) return;
  uint tag = 0x0400u + ((i >> 2) & 0x3FFFu);
  uint word = i >> 1u;
  if ((i & 1u) == 0u) atomicOr(values[word], tag);
  else atomicOr(values[word], tag << 16u);
}
