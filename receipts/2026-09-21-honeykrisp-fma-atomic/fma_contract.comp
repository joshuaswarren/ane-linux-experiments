// NoContraction (precise) FMA-contraction reproducer v2.
// Independent chains (duplicated input regions) so CSE cannot merge them.
// a = 1+2^-23, b = 1-2^-23, c = -1: exact product is 1-2^-46.
//   separate rounding: round(a*b) = 1.0 -> +0.0
//   contracted fma:    exact -2^-46 (a normal float)
// Element i: inputs in[6i..6i+2] (for p) and in[6i+3..6i+5] (same values, for q)
//   results[2i]   = precise a*b+c    (must be +0.0 under NoContraction)
//   results[2i+1] = unconstrained    (may fuse to ffma -> -2^-46)
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 1) buffer Out { float results[]; };
layout(set = 0, binding = 0) buffer In { float abc[]; };
void main() {
  uint i = gl_GlobalInvocationID.x;
  float a0 = abc[6*i+0], b0 = abc[6*i+1], c0 = abc[6*i+2];
  float a1 = abc[6*i+3], b1 = abc[6*i+4], c1 = abc[6*i+5];
  precise float p = a0 * b0 + c0;
  results[2*i+0] = p;
  float q = a1 * b1 + c1;
  results[2*i+1] = q;
}
