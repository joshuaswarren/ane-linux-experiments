		iommu@26b800000 {
			compatible = "apple,t8103-dart";
			reg = <0x02 0x6b800000 0x00 0x4000>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x1a1 0x04>;
			#iommu-cells = <0x01>;
			power-domains = <0x82>;
			status = "okay";
			phandle = <0xc6>;
		};

		iommu@26b810000 {
			compatible = "apple,t8103-dart";
			reg = <0x02 0x6b810000 0x00 0x4000>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x1a1 0x04>;
			#iommu-cells = <0x01>;
			power-domains = <0x82>;
			status = "okay";
			phandle = <0xc7>;
		};

		iommu@26b820000 {
			compatible = "apple,t8103-dart";
			reg = <0x02 0x6b820000 0x00 0x4000>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x1a1 0x04>;
			#iommu-cells = <0x01>;
			power-domains = <0x82>;
			status = "okay";
			phandle = <0xc8>;
		};

		ane@26a000000 {
			compatible = "apple,t8103-ane";
			reg-names = "engine";
			reg = <0x02 0x6bc04000 0x00 0x24000>;
			interrupt-parent = <0x0f>;
			interrupt-names = "ane";
			interrupts = <0x00 0x1a0 0x04>;
			iommus = <0xc6 0x00>, <0xc7 0x00>, <0xc8 0x00>;
			power-domains = <0x82>, <0xc5>;
			status = "okay";
		};
